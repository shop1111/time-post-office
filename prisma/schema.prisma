generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 一条原始生活记录：照片 / 语音 / 日记
model Entry {
  id            String         @id @default(cuid())
  type          String // photo | voice | text
  text          String         @default("")
  transcript    String?
  photoPath     String?
  audioPath     String?
  audioMime     String?
  visionCaption String?
  exifTime      DateTime?
  lat           Float?
  lng           Float?
  place         String?
  occurredAt    DateTime
  mood          Float? // -1 ~ 1
  emotions      String         @default("[]") // JSON string[]
  title         String?
  summary       String?
  interviewDone Boolean        @default(false)
  createdAt     DateTime       @default(now())
  messages      EntryMessage[]
  memories      Memory[]
  cards         StoryCard[]
  conversation  XiaojuConversation?
  insights      XiaojuInsight[]

  @@index([occurredAt])
}

/// AI 追问对话
model EntryMessage {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([entryId])
}

/// 结构化记忆
model Memory {
  id             String         @id @default(cuid())
  entryId        String?
  entry          Entry?         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind           String // event | fact | person | place | goal | plan | preference
  content        String
  importance     Int            @default(5) // 1-10
  occurredAt     DateTime
  dueAt          DateTime?
  embedding      Bytes?
  lastRecalledAt DateTime?
  recallCount    Int            @default(0)
  userEdited     Boolean        @default(false)
  status         String         @default("active") // active | retracted
  revision       Int            @default(0)
  retractedAt    DateTime?
  resolved       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  entities       MemoryEntity[]

  @@index([occurredAt])
  @@index([kind])
}

model Entity {
  id        String         @id @default(cuid())
  name      String
  type      String // person | place | theme
  note      String?
  createdAt DateTime       @default(now())
  memories  MemoryEntity[]

  @@unique([name, type])
}

model MemoryEntity {
  memoryId String
  entityId String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([memoryId, entityId])
}

/// 用户画像（单例 id = "me"）
model Profile {
  id          String   @id @default("me")
  name        String   @default("你")
  summary     String   @default("")
  traits      String   @default("[]") // JSON string[]
  style       String   @default("{}") // JSON StyleFingerprint
  updatedAt   DateTime @updatedAt
}

/// 收件人：某个人 / 平行时空的自己 / 未来的自己 / 邮局主理人小局
model Correspondent {
  id        String    @id @default(cuid())
  kind      String // person | parallel_self | future_self | curator
  name      String
  relation  String    @default("") // 他是谁、和我的关系
  moment    String    @default("") // 那个瞬间发生了什么 / 平行时空的分岔：当时如果选了……
  momentAt  DateTime? // 只能是过去
  voice     String    @default("") // 他说话的样子（用户描述，可选）
  createdAt DateTime  @default(now())
  letters   Letter[]
}

/// 信件：小局的来信、用户寄出的信、代笔回信、写给未来自己的信
model Letter {
  id              String         @id @default(cuid())
  sender          String // user | curator | persona（旧数据可能是 past_self | future_self | postman）
  correspondentId String?
  correspondent   Correspondent? @relation(fields: [correspondentId], references: [id], onDelete: Cascade)
  inReplyToId     String?
  subject         String
  body            String
  triggerType     String // anniversary | open_loop | low_mood | milestone | greeting | reply | future_letter | letter | welcome | manual
  triggerKey      String?        @unique // 去重键
  reason          String         @default("")
  checkStatus     String         @default("unchecked")
  checkNote       String         @default("")
  citedMemoryIds  String         @default("[]") // JSON string[]
  knowledge       String         @default("{}") // JSON：代笔时判定的「他知道 / 他不知道」
  writtenAt       DateTime       @default(now())
  scheduledAt     DateTime
  deliveredAt     DateTime?
  readAt          DateTime?
  replyDueAt      DateTime? // 寄给虚拟收件人的信：代笔回信的时间
  replyLetterId   String? // 回信生成后回填，防止重复生成
  reply           String? // 旧版回信（只读展示）
  repliedAt       DateTime?
  createdAt       DateTime       @default(now())

  @@index([scheduledAt])
  @@index([correspondentId])
  @@index([replyDueAt])
}

model StoryCard {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title     String
  narrative String
  quote     String   @default("")
  template  String   @default("paper") // paper | film | night | postcard
  createdAt DateTime @default(now())
}

model MonthlyRecap {
  id        String   @id @default(cuid())
  month     String   @unique // 2026-07
  payload   String // JSON
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// 阶段状态和内部检查点由业务事务维护；日期通过 API 序列化为 ISO 字符串。
model Job {
  id           String   @id @default(cuid())
  kind         String
  targetId     String
  status       String   @default("queued")
  currentStage String?
  stages       String   @default("[]")
  checkpoint   String? // 内部中间结果，支持重试复用；不暴露给前端
  result       String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, targetId])
}

/// 仅创建胶囊期间开放；保存后不可重新开启。
model XiaojuConversation {
  id           String   @id @default(cuid())
  entryId      String   @unique
  entry        Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status       String   @default("offered") // offered | active | ended | skipped
  revision     Int      @default(0)
  state        String   @default("{}")
  activeTurnId String?
  leaseUntil   DateTime?
  reflectedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  turns        XiaojuTurn[]
}

model XiaojuTurn {
  id             String   @id @default(cuid())
  conversationId String
  conversation   XiaojuConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId      String
  userText       String   @default("")
  status         String   @default("running") // running | completed | failed | cancelled
  attempt        Int      @default(1)
  plan           String?
  response       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([conversationId, requestId])
}

/// 有证据的交流偏好/会话反思；推测仅候选，不自动作为事实。
model XiaojuInsight {
  id         String   @id @default(cuid())
  entryId    String
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind       String // preference | reflection
  content    String
  quote      String
  status     String   @default("candidate") // candidate | active | retracted
  sourceRefs String   @default("[]") // memory id + revision; empty sources are not used across conversations
  createdAt  DateTime @default(now())

  @@index([status, kind])
  @@unique([entryId, kind, quote])
}
