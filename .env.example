# ===== 数据与账号 =====
# 数据目录：auth.db（账号）、template.db（新用户模板）、users/<id>/（每个用户独立的库和上传文件）
# DATA_DIR="./data"
# 仅供 prisma 命令行工具（如 prisma studio）使用；应用本身按登录用户选择数据库
DATABASE_URL="file:../data/template.db"

# 是否开放注册：1 开放（默认），0 关闭（只允许已有账号登录）
ALLOW_REGISTRATION="1"
# 邀请码：填写后注册时必须输入（避免陌生人消耗你的模型额度），留空则不需要
INVITE_CODE=""
# 最多注册多少个账号，0 或留空表示不限
# MAX_USERS="50"
# 登录 Cookie 的 Secure 标记：默认按访问协议自动判断（HTTPS 时开启）；1 强制开启，0 强制关闭
# COOKIE_SECURE=""

# ===== AI Provider（全部走 OpenAI 兼容协议，按角色单独配置）=====
# 不填任何 KEY 时自动进入 Mock 演示模式，全部功能可离线体验。
# 本地开发体验：设为 1 后可在本机设置页临时配置模型。公开部署保持关闭。
ENABLE_LOCAL_MODEL_SETTINGS="0"

# 对话 / 写信 / 抽取：DeepSeek（OpenAI 兼容格式，见 https://api-docs.deepseek.com/）
# base_url：https://api.deepseek.com
# model：deepseek-flash（当前为 DeepSeek-V4.1-Flash-1017）或 deepseek-v4-pro
#   旧模型名 deepseek-v4-flash / deepseek-v4-flash-vision-exp 仍可调用，但已由 V4.1-Flash 提供服务
CHAT_BASE_URL="https://api.deepseek.com"
CHAT_API_KEY=""
CHAT_MODEL="deepseek-flash"
# 思考模式：仅在直连 api.deepseek.com 时发送 thinking 参数，其他兼容服务商不发送。
# 开启后推理内容不展示给用户，但会计入 max_tokens，因此每次请求自动追加推理预算。
CHAT_THINKING="off"
# CHAT_THINKING_BUDGET_TOKENS="4000"

# 超时与重试：不填即用默认值。思考模式下默认值自动放宽（总超时 120s、流式总超时 180s）。
# 总超时包含排队、网络重试、退避与读取响应；JSON修复共用同一预算。
# AI_TIMEOUT_MS="45000"
# 可分别设置 CHAT_TIMEOUT_MS / VISION_TIMEOUT_MS / EMBED_TIMEOUT_MS / ASR_TIMEOUT_MS
# AI_STREAM_TOTAL_TIMEOUT_MS="90000"
# 首包 / 空闲超时：推理内容也算作「有响应」
# AI_STREAM_FIRST_TIMEOUT_MS="15000"
# AI_STREAM_IDLE_TIMEOUT_MS="15000"
# AI_MAX_CONCURRENCY="3"
# 网络/429/5xx最多重试2次；基础退避乘2并加随机抖动。
# AI_RETRY_BASE_MS="300"

# 看图：独立配置，支持视觉的 DeepSeek Flash 或通义千问 / 硅基流动视觉模型
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-vl-plus
# 例：https://api.siliconflow.cn/v1  + Qwen/Qwen2.5-VL-72B-Instruct
VISION_BASE_URL=""
VISION_API_KEY=""
VISION_MODEL=""

# 向量：lite = 本地中文 n-gram 哈希向量（默认，离线可用）；api = 远程 embedding
EMBED_MODE="lite"
EMBED_BASE_URL="https://api.siliconflow.cn/v1"
EMBED_API_KEY=""
EMBED_MODEL="BAAI/bge-m3"

# 语音转写：不填则使用浏览器 Web Speech API 实时转写
ASR_BASE_URL=""
ASR_API_KEY=""
ASR_MODEL="FunAudioLLM/SenseVoiceSmall"
